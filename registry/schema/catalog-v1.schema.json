{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/soupmasters/AsepriteExtensionManager/blob/master/registry/schema/catalog-v1.schema.json",
  "title": "Aseprite Extension Manager Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/package"
      }
    }
  },
  "definitions": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifestName",
        "displayName",
        "author",
        "license",
        "homepage",
        "repository",
        "releases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Case-folded Aseprite manifest name."
        },
        "manifestName": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX license expression."
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/release"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "aseprite",
        "asset",
        "publishedAt",
        "releaseNotes",
        "yanked"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "aseprite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumVersion",
            "minimumApi"
          ],
          "properties": {
            "minimumVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
            },
            "maximumVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
            },
            "minimumApi": {
              "type": "integer",
              "minimum": 1
            },
            "maximumApi": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "sha256",
            "byteLength"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            },
            "releaseTag": {
              "type": "string",
              "minLength": 1
            },
            "assetId": {
              "type": "integer",
              "minimum": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$",
              "description": "Immutable GitHub commit for a normalized repository snapshot."
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "commit"
                ]
              },
              "then": {
                "properties": {
                  "url": {
                    "pattern": "^https://codeload\\.github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/zip/[a-f0-9]{40}$"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "releaseTag"
                      ]
                    },
                    {
                      "required": [
                        "assetId"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releaseNotes": {
          "type": "string"
        },
        "yanked": {
          "type": "boolean"
        }
      }
    }
  }
}
